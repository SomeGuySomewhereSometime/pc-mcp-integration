[Unit]
Description=ChatGPT MCP tunnel (chatgpt-local-bridge)
After=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/home/user
ExecStart=/usr/bin/python3 /home/user/.local/lib/mcp-integration/launch.py tunnel-bridge
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
KillMode=control-group
UMask=0077
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mcp-chatgpt-local-bridge
LogRateLimitIntervalSec=30s
LogRateLimitBurst=1000

[Install]
WantedBy=default.target
